# virtual environment (each person makes their own)
.venv/
venv/

# build output (GitHub Actions rebuilds the web version)
build/

# Python cache
__pycache__/
*.pyc

# old .wav copies of the sounds (the game uses the .ogg files)
sounds/*.wav

# your saved game records on this PC (the web version saves in the browser)
records.json

# personal step-by-step notes
INSTRUCTIONS.md
